# Production environment.
#
# Deliberately not derived from .env.example: that file is tuned for a laptop
# and, among other things, loads the overlay that hands the Docker socket to the
# application. Copying it into production is how a demo convenience becomes a
# privilege escalation.
#
#   cp .env.production.example .env
#
# Every value below marked REQUIRED has to be set. The API validates them at
# boot and refuses to start if they are wrong (app/core/readiness.py), because a
# control plane that cannot reach its engine has no useful degraded mode.

# ── environment ────────────────────────────────────────────────────────────
# Turns on strict behaviour: a broken engine configuration stops the process
# instead of logging and continuing.
APP_ENV=production

# COMPOSE_FILE is intentionally absent. Only docker-compose.yml applies, and it
# mounts no Docker socket anywhere.

# ── engine ─────────────────────────────────────────────────────────────────
# Production runs on an Airbyte deployment. The embedded runner reproduces none
# of the job, retry, isolation or upgrade semantics Airbyte provides, and is
# rejected at boot when APP_ENV=production.
ENGINE_TYPE=AIRBYTE_API

# REQUIRED. Reachable only from the private network — never expose the Airbyte
# API to a browser (guardrail 1: the FE talks to this product's API only).
AIRBYTE_API_URL=http://airbyte-server:8001

# REQUIRED. Every resource this product creates belongs to this workspace.
# Find it with `python scripts/airbyte-workspace.py list` and verify it with
# `verify --id` before release: a valid-looking UUID from a different Airbyte
# passes every check the product makes and then creates customer connections in
# someone else's tenant. See docs/RUNBOOK-airbyte-workspace.md.
AIRBYTE_WORKSPACE_ID=

# Never true in production. On a local stack with exactly one workspace this
# lets the adapter resolve it; production must decide which tenant receives
# customer data rather than inherit a default.
AIRBYTE_WORKSPACE_AUTO=false

# Engine credentials. Pick ONE scheme; setting both is refused at startup,
# because the adapter prefers client credentials and the unused Basic pair
# would mislead whoever reads this next.
#
# Airbyte 1.x with auth enabled: an Application's client credentials, created
# in Airbyte. HTTP Basic is answered with 401 there -- including the instance
# admin's own email and password -- so Basic against 1.x looks exactly like an
# engine outage.
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Airbyte 0.59.x only. Both or neither.
AIRBYTE_API_USERNAME=
AIRBYTE_API_PASSWORD=

# ── secrets ────────────────────────────────────────────────────────────────
# REQUIRED. Exactly 32 bytes, urlsafe-base64. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# A key that does not decode to 32 bytes is refused: deriving one from a
# passphrase would make the entropy of every stored credential equal to the
# entropy of that passphrase.
SECRET_ENCRYPTION_KEY=

# Never true in production. Exists so local development can use a passphrase.
ALLOW_DERIVED_ENCRYPTION_KEY=false

# ── database ───────────────────────────────────────────────────────────────
# REQUIRED. The product's own database, on its own instance.
#
# Not Airbyte's, and not beside Airbyte's. The API refuses to start if this
# points at a database containing Airbyte's schema, and warns in production if
# Airbyte's database is merely visible on the same instance. Both checks exist
# because the guardrail — the product never reads the engine's metadata
# database — was previously enforced by nothing: on the staging stack the
# product's role could read all 47 of Airbyte's tables.
#
# The role here should have no CONNECT grant on Airbyte's database. The SQL is
# in docs/ADR-001-database-topology.md, along with why this matters more as the
# product grows past what Airbyte does.
DATABASE_URL=
DATABASE_URL_SYNC=

# ── connector egress ───────────────────────────────────────────────────────
# Connectors may not be pointed at private or link-local addresses. Add specific
# hostnames or CIDRs here to allow an internal API deliberately.
#
# This is a preflight guardrail, not a boundary: it cannot stop a redirect or a
# URL built at request time. In production the real control belongs at the
# Airbyte worker layer — an egress proxy or network policy on the deployment
# that actually makes the requests.
EGRESS_ALLOW_PRIVATE=false
EGRESS_ALLOWLIST=

# Measure what a connector can actually reach rather than assuming:
#   python qa/probes/verify-egress.py
# docker-compose.egress.yml blocks outbound entirely (fail-closed, and SaaS
# connectors stop working under it). A per-host allowlist is a host firewall or
# NetworkPolicy job — rules in docs/RUNBOOK-egress.md.

# ── readiness ──────────────────────────────────────────────────────────────
# Both default to the lenient answer deliberately.
#
# READINESS_REQUIRE_ENGINE makes plain /readyz fail when the engine is down.
# Leave it false unless you have thought this through: /readyz is what a load
# balancer reads, and failing it during an engine outage removes every API
# instance from rotation — nobody can then read run history, see why the engine
# is down, or acknowledge the alert. Point deploy gates at /readyz?deep=1
# instead, which always requires the engine.
READINESS_REQUIRE_ENGINE=false

# STARTUP_REQUIRE_ENGINE makes the process refuse to start when the engine does
# not answer. A configuration error is already fatal; this covers unreachability
# too, which usually means "the engine is still booting" and produces a crash
# loop that looks like a product fault.
STARTUP_REQUIRE_ENGINE=false

# ── seeding ────────────────────────────────────────────────────────────────
# No demo data, and no default administrator password.
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── ports ──────────────────────────────────────────────────────────────────
PROXY_PORT=8080
FRONTEND_PORT=3000
API_PORT=8000

# --- Launch scope ------------------------------------------------------------
# The bundled registry carries 654 connectors; this deployment offers only the
# ones compatibility.yaml records a real `check` for. Setting FULL_CATALOG
# offers all 654 and makes this deployment's operator responsible for the 647
# nobody here has run.
CONNECTOR_LAUNCH_SCOPE=SUPPORTED_ONLY
# Comma-separated per-connector opt-in for BETA connectors, for a deployment
# that has done its own UAT on a few without adopting the whole catalogue.
# source-microsoft-onedrive is the Excel Online path and is BETA because its
# `check` has never been run against a real Microsoft tenant.
CONNECTOR_BETA_ALLOWLIST=

# --- Demo sign-in prefill ----------------------------------------------------
# Deliberately empty, and deliberately present so the omission is visible.
# Setting either of these bakes a credential into the frontend bundle where any
# visitor can read it. Production creates no such account.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
