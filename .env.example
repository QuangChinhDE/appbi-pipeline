# ── AppBI Data Integration Platform ────────────────────────────────────────
# Copy to .env and adjust. Everything has a working local default.

APP_ENV=local
LOG_LEVEL=INFO

# Ports published on the host
PROXY_PORT=8080          # <- open http://localhost:8080
FRONTEND_PORT=3100
API_PORT=8010
POSTGRES_PORT=55433

POSTGRES_PASSWORD=appbi

# Session signing key
JWT_SECRET=dev-jwt-secret-change-me

# Envelope-encryption KEK for the credential store (urlsafe-base64, 32 bytes).
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=REPLACE_ME__see_the_generate_command_above

# ── Execution engine ───────────────────────────────────────────────────────
# AIRBYTE_EMBEDDED : run official Airbyte connector images locally over the
#                    Airbyte Protocol via the host Docker daemon (default).
# AIRBYTE_API      : delegate to an existing self-managed Airbyte deployment.
ENGINE_TYPE=AIRBYTE_EMBEDDED

AIRBYTE_API_URL=
AIRBYTE_API_USERNAME=
AIRBYTE_API_PASSWORD=
AIRBYTE_WORKSPACE_ID=

# ── Platform policy ────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS_GLOBAL=4
MAX_CONCURRENT_RUNS_PER_WORKSPACE=3
MIN_SCHEDULE_INTERVAL_SECONDS=300
RUN_TIMEOUT_SECONDS=7200

# Local development runs the embedded engine, which needs the Docker socket.
# Setting COMPOSE_FILE here means a plain `docker compose up` picks up the
# overlay on a developer machine; a production environment does not set this,
# so it never gets the socket by accident.
#
# COMPOSE_PATH_SEPARATOR is pinned because Compose defaults to ";" on Windows
# and ":" elsewhere — without it this line works on one half of the team.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.embedded.yml
