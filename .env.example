# ── AppBI Data Integration Platform ────────────────────────────────────────
# Copy to .env and adjust. Everything has a working local default.

APP_ENV=local
LOG_LEVEL=INFO

# Ports published on the host
PROXY_PORT=8080          # <- open http://localhost:8080
FRONTEND_PORT=3100
API_PORT=8010
POSTGRES_PORT=55433

POSTGRES_PASSWORD=appbi

# Session signing key
JWT_SECRET=dev-jwt-secret-change-me

# Envelope-encryption KEK for the credential store (urlsafe-base64, 32 bytes).
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=REPLACE_ME__see_the_generate_command_above

# ── Execution engine ───────────────────────────────────────────────────────
# AIRBYTE_EMBEDDED : run official Airbyte connector images locally over the
#                    Airbyte Protocol via the host Docker daemon (default).
# AIRBYTE_API      : delegate to an existing self-managed Airbyte deployment.
ENGINE_TYPE=AIRBYTE_EMBEDDED

AIRBYTE_API_URL=
AIRBYTE_API_USERNAME=
AIRBYTE_API_PASSWORD=
AIRBYTE_WORKSPACE_ID=

# ── Platform policy ────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS_GLOBAL=4
MAX_CONCURRENT_RUNS_PER_WORKSPACE=3
MIN_SCHEDULE_INTERVAL_SECONDS=300
RUN_TIMEOUT_SECONDS=7200

# Local development runs the embedded engine, which needs the Docker socket.
# Setting COMPOSE_FILE here means a plain `docker compose up` picks up the
# overlay on a developer machine; a production environment does not set this,
# so it never gets the socket by accident.
#
# COMPOSE_PATH_SEPARATOR is pinned because Compose defaults to ";" on Windows
# and ":" elsewhere — without it this line works on one half of the team.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.embedded.yml

# --- Launch scope -----------------------------------------------------------
# The bundled registry carries 654 connectors. SUPPORTED_ONLY offers only the
# ones compatibility.yaml records real evidence for -- currently Postgres,
# BigQuery (both directions), Google Sheets and faker.
CONNECTOR_LAUNCH_SCOPE=SUPPORTED_ONLY
# Per-connector opt-in for BETA connectors this deployment has decided to take
# on. destination-google-sheets writes to a spreadsheet: its `spec` runs, but no
# `check` has been proven against a real sheet, so it is offered knowingly
# rather than certified. The four advertising sources are the same shape: each
# authenticates with OAuth against somebody's ad account, and nobody here has
# one, so the form and the image are all that were verified. Listing them makes
# them selectable; it does not make them certified.
CONNECTOR_BETA_ALLOWLIST=destination-google-sheets,destination-mssql,source-facebook-marketing,source-google-ads,source-bing-ads,source-tiktok-marketing,source-kiotviet,source-zalo-ads

# --- Demo sign-in prefill (local only) ---------------------------------------
# Next inlines NEXT_PUBLIC_* at build time. Set these and the sign-in page
# prefills the seeded account; leave them empty and no credential exists in the
# built bundle at all. Never set them for a production build.
NEXT_PUBLIC_DEMO_EMAIL=admin@appbi.local
NEXT_PUBLIC_DEMO_PASSWORD=Admin@12345

# --- Host-side database URL --------------------------------------------------
# The containers do NOT read this: docker-compose.yml sets DATABASE_URL
# explicitly per service, using the in-network hostname, and an explicit
# service `environment:` wins over anything here.
#
# This is the same database reached from the host, over the published loopback
# port, for tools that run outside the stack -- `scan-plaintext-secrets.py
# --config`, backups, one-off queries. `deploy/demo.yaml` declares
# `database_url_ref: env://DATABASE_URL`, and until this existed that reference
# resolved to nothing at all.
DATABASE_URL=postgresql+asyncpg://appbi:appbi@localhost:55433/appbi_integration
