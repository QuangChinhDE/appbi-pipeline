# ── AppBI Data Integration Platform ────────────────────────────────────────
# Copy to .env and adjust. Everything has a working local default.

APP_ENV=local
LOG_LEVEL=INFO

# Ports published on the host
PROXY_PORT=8080          # <- open http://localhost:8080
FRONTEND_PORT=3100
API_PORT=8010
POSTGRES_PORT=55433

# Which interface each of those is published on. The default is loopback: the
# port is reachable from this machine and from nowhere else, which is what you
# want unless something on another host has to reach it.
#
# `0.0.0.0` publishes on every interface. Before setting it, know what you are
# opening: POSTGRES_HOST exposes the database itself, and API_HOST exposes
# /metrics, which has no authentication because it is meant for an internal
# scraper. The public entry point is the proxy on PROXY_PORT; these three are
# for tools and debugging.
POSTGRES_HOST=127.0.0.1
API_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1

POSTGRES_PASSWORD=appbi

# ── Hai khóa dưới đây do run.sh sinh ra, đừng điền tay ──────────────────────
# Cả hai để TRỐNG là đúng: `./run.sh` sinh giá trị riêng cho từng máy ngay lần
# chạy đầu. Để trống còn có tác dụng thứ hai — nếu ai copy tay file này thành
# .env mà không qua run.sh, Compose sẽ dừng ngay với thông báo rõ ràng, thay vì
# khởi động bình thường rồi hỏng lúc lưu Nguồn đầu tiên.
#
# Khóa ký cookie phiên. Trước đây ship sẵn một chuỗi cố định, nghĩa là ai có
# repository này cũng ký được phiên đăng nhập cho bất kỳ bản triển khai nào
# chưa đổi nó.
JWT_SECRET=

# Khóa mã hóa kho thông tin đăng nhập (urlsafe-base64, 32 byte = 44 ký tự).
#
# Mất khóa này là mất toàn bộ credential đã lưu — không giải mã lại được. Nên
# `run.sh` sao lưu .env vào .env.backups/ mỗi lần chạy, và chỉ sinh khóa khi ô
# này thật sự trống.
#
# Muốn tự sinh:  openssl rand -base64 32 | tr '+/' '-_'
SECRET_ENCRYPTION_KEY=

# ── Execution engine ───────────────────────────────────────────────────────
# AIRBYTE_EMBEDDED : run official Airbyte connector images locally over the
#                    Airbyte Protocol via the host Docker daemon (default).
# AIRBYTE_API      : delegate to an existing self-managed Airbyte deployment.
ENGINE_TYPE=AIRBYTE_EMBEDDED

AIRBYTE_API_URL=
AIRBYTE_API_USERNAME=
AIRBYTE_API_PASSWORD=
AIRBYTE_WORKSPACE_ID=

# --- AI-assisted Connector Builder -----------------------------------------
# Optional. Add a project key to enable documentation analysis, planning and
# in-editor proposals. This value is sent only to the product backend.
OPENAI_API_KEY=
OPENAI_MODEL_PLANNER=gpt-4o-mini
OPENAI_MODEL_AGENT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini

# ── Platform policy ────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS_GLOBAL=4
MAX_CONCURRENT_RUNS_PER_WORKSPACE=3
# Số sync một tiến trình worker chạy cùng lúc. Trước đây biến này có trong mã
# nhưng không được truyền vào container, nên đặt ở đây cũng không có tác dụng.
WORKER_MAX_PARALLEL_SYNCS=4
# Nguồn và Đích mẫu, để một bản cài mới có cái mà bấm thử. Trên máy của khách
# thì đó là hai kết nối không ai tạo ra — đặt 0.
SEED_DEMO_DATA=1

# --- Tự chạy lại khi lỗi tạm thời -------------------------------------------
# Nguồn từ chối vài phút rồi bình thường lại là chuyện thường: một bản triển
# khai thực tế có pipeline hỏng ba lần liên tiếp ở đúng bản ghi 1319 rồi chạy
# được ở lần thứ tư, mười ba phút sau — cả bốn lần đều do người bấm tay.
#
# Chỉ lỗi được phân loại là tạm thời mới được thử lại: mất kết nối giữa chừng,
# hết giờ chờ, bị giới hạn tần suất. Token sai thì không, vì nó không tự đúng
# lên được. Đặt 0 để tắt hẳn.
AUTO_RETRY_MAX_ATTEMPTS=3
# Lần chờ đầu tiên, mỗi lần sau gấp đôi: 60 -> 120 -> 240.
AUTO_RETRY_BASE_SECONDS=60
# Trần, để một chuỗi dài không đẩy lần thử kế tiếp sang tuần sau.
AUTO_RETRY_MAX_SECONDS=1800

# --- Tài nguyên cho mỗi connector -------------------------------------------
# Mỗi lần sync chạy HAI container: một source và một destination. Nên ngân sách
# RAM là:
#
#     MAX_CONCURRENT_RUNS_GLOBAL x 2 x CONNECTOR_MEMORY_LIMIT
#         + ~800 MB cho AppBI + ~200 MB cho Postgres
#
# Với mặc định dưới đây, 4 lần chạy song song cần ~8 GB chỉ riêng connector.
# Trên VM 2 CPU / 8 GB hãy đặt MAX_CONCURRENT_RUNS_GLOBAL=1 (nhiều nhất là 2):
# hai nhân thì chạy song song cũng không nhanh hơn, chỉ tốn RAM.
#
# Để trống là bỏ trần — container connector khi đó có thể lấy hết RAM máy, và
# thứ dừng nó sẽ là OOM killer của hệ điều hành, thứ có thể chọn nạn nhân là
# `api` hoặc `worker` thay vì chính connector đó.
CONNECTOR_MEMORY_LIMIT=2g
# `docker run --cpus`. Để trống là không giới hạn. Trên máy 2 nhân, một
# connector không bị giới hạn sẽ bỏ đói event loop của API và giao diện đứng
# giữa lúc sync.
CONNECTOR_CPU_LIMIT=
# Số bản ghi mỗi lần gọi, cho mọi connector khai báo cỡ trang. 0 là để nguyên
# lựa chọn của từng connector.
#
# Một trang được giữ nguyên trong bộ nhớ container nguồn trước khi ghi ra, nên
# đây là cái van khi máy không kham nổi 2 GB cho mỗi connector. Đo được: ticket
# của Base Work trung bình ~326 KB, một trang 500 là ~163 MB; hạ xuống 100 thì
# bộ nhớ giảm khoảng năm lần, số lần gọi API tăng năm lần.
#
# Từng nguồn còn ghi đè được bằng ô "Số bản ghi mỗi lần gọi" trong form Nguồn,
# dành cho tenant có bản ghi to bất thường. Đừng sửa page_size thẳng vào
# backend/app/connectors/ — bản vá đó mất sau mỗi lần cập nhật.
CONNECTOR_DEFAULT_PAGE_SIZE=0
# Destination BigQuery / Postgres / MSSQL của Airbyte chạy trên JVM và lấy heap
# theo tỷ lệ của trần container. JVM mặc định chỉ lấy 25%, tức 256 MB với trần
# 1 GB — không đủ, và nó sẽ hỏng theo kiểu chẳng liên quan gì tới nguyên nhân.
# Python connector không đọc biến này.
CONNECTOR_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
MIN_SCHEDULE_INTERVAL_SECONDS=300
RUN_TIMEOUT_SECONDS=7200

# Local development runs the embedded engine, which needs the Docker socket.
# Setting COMPOSE_FILE here means a plain `docker compose up` picks up the
# overlay on a developer machine; a production environment does not set this,
# so it never gets the socket by accident.
#
# COMPOSE_PATH_SEPARATOR is pinned because Compose defaults to ";" on Windows
# and ":" elsewhere — without it this line works on one half of the team.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.embedded.yml:docker-compose.transform.yml

# --- Transform: on or off ----------------------------------------------------
# Transform is optional, and on a small VM it is worth being able to leave out.
# It costs two things, turned off independently:
#
#   1. `docker-compose.transform.yml` in COMPOSE_FILE runs the worker process
#      (~90 MB idle, ~210 MB while a dbt build is running). Drop it from the
#      line above and the worker never starts.
#
#   2. WITH_TRANSFORM decides whether dbt is *in the image*. This is the large
#      one: dbt-core pulls in pandas, pyarrow, numpy and the google-cloud
#      client stack, so the backend image is 1.56 GB with it and 479 MB
#      without -- a gigabyte of disk and a much shorter build.
#
# Turn both off for a Pipeline-only deployment:
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.embedded.yml
#   WITH_TRANSFORM=0
#
# Nothing in the API imports dbt -- it runs the binary as a subprocess -- so a
# slim image serves every other part of AppBI unchanged. The Transform screens
# refuse politely instead of failing: a run that no worker could claim is
# rejected while the person is still looking at the screen.
#
# Changing this requires a rebuild (`./run.sh` does it), not just a restart.
WITH_TRANSFORM=1

# --- Launch scope -----------------------------------------------------------
# The bundled registry carries 654 connectors. SUPPORTED_ONLY offers only the
# ones compatibility.yaml records real evidence for -- currently Postgres,
# BigQuery (both directions), Google Sheets and faker.
CONNECTOR_LAUNCH_SCOPE=SUPPORTED_ONLY
# Per-connector opt-in for BETA connectors this deployment has decided to take
# on. destination-google-sheets writes to a spreadsheet: its `spec` runs, but no
# `check` has been proven against a real sheet, so it is offered knowingly
# rather than certified. The four advertising sources are the same shape: each
# authenticates with OAuth against somebody's ad account, and nobody here has
# one, so the form and the image are all that were verified. Listing them makes
# them selectable; it does not make them certified.
CONNECTOR_BETA_ALLOWLIST=destination-google-sheets,destination-mssql,source-facebook-marketing,source-google-ads,source-bing-ads,source-tiktok-marketing,source-kiotviet,source-zalo-ads

# --- The administrator account -----------------------------------------------
# Who signs in first, and with what. These are read on every start and the
# database is brought into line with them: change the password here, run
# ./run.sh, and the account's password changes. Change the email and the
# existing administrator is renamed rather than a second one appearing.
#
# That means this file wins over a password changed in the web UI. It is the
# behaviour that makes "I forgot the admin password" solvable without a
# database console, and the reason to keep this file readable only by the
# people who run the deployment.
#
# ./run.sh fills the password in with a generated one the first time, and
# prints it once. It is never shown in the web UI.
SEED_ADMIN_EMAIL=admin@appbi.local
SEED_ADMIN_PASSWORD=

# --- Host-side database URL --------------------------------------------------
# The containers do NOT read this: docker-compose.yml sets DATABASE_URL
# explicitly per service, using the in-network hostname, and an explicit
# service `environment:` wins over anything here.
#
# This is the same database reached from the host, over the published loopback
# port, for tools that run outside the stack -- `scan-plaintext-secrets.py
# --config`, backups, one-off queries. `deploy/demo.yaml` declares
# `database_url_ref: env://DATABASE_URL`, and until this existed that reference
# resolved to nothing at all.
DATABASE_URL=postgresql+asyncpg://appbi:appbi@localhost:55433/appbi_integration

# --- Transform project storage -----------------------------------------------
# Where dbt project revisions and dbt artifacts (manifest, run_results, catalog)
# are kept. Postgres holds only the metadata and index rows that point at them:
# a manifest for a mid-sized project is tens of megabytes and one is produced
# per parse, so the product database is the wrong place for it.
#
# `local` is a directory on a shared volume and is the development default.
# Production should be `s3` -- any S3-compatible endpoint, including MinIO, R2
# or real AWS S3. Nothing else in AppBI reads this store; Pipeline and Airbyte
# are unaffected by it.
TRANSFORM_STORAGE_BACKEND=local
# TRANSFORM_STORAGE_BACKEND=s3
# TRANSFORM_STORAGE_S3_BUCKET=appbi-transform
# TRANSFORM_STORAGE_S3_REGION=ap-southeast-1
# TRANSFORM_STORAGE_S3_ACCESS_KEY=
# TRANSFORM_STORAGE_S3_SECRET_KEY=
# Set for MinIO or any non-AWS gateway; leave empty for real AWS S3.
# TRANSFORM_STORAGE_S3_ENDPOINT_URL=
# TRANSFORM_STORAGE_S3_PREFIX=transform
# MinIO does not serve virtual-hosted buckets, so it needs path style.
# TRANSFORM_STORAGE_S3_FORCE_PATH_STYLE=false
#
# To rehearse the S3 path locally with MinIO, without adding it to the base
# stack:  docker compose -f docker-compose.yml -f docker-compose.storage.yml up -d
