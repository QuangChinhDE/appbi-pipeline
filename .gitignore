# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# node
node_modules/
.next/
e2e-shots/
.shots/



# local config and artefacts
.env
# Every env file except the committed examples. `.env` on its own does not
# match `.env.test`, `.env.local` or anything else with a suffix -- which is
# how a file full of live GCP service-account keys ends up staged by a `git
# add -A` that looked harmless.
.env.*
!.env.example
!.env.production.example

# Google service-account keys and OAuth client secrets, wherever they land.
*service-account*.json
*client_secret*.json
gcp-*.json
# Local BigQuery testlab keys use the project name rather than the usual
# service-account filename. Keep them out even when placed at the repo root.
base-testlab-*.json
credentials/
secrets/
evidence-connectors.json
*.log
tsconfig.tsbuildinfo
frontend/audit-ui.mjs
frontend/probe*.mjs
audit-shots/
frontend/audit-behaviour.mjs
frontend/shoot.mjs
frontend/builder-walkthrough.mjs
frontend/builder-surface-shots.mjs

# Certification output. Regenerated by a run; committing it would let a stale
# artifact certify a release it never saw. CI publishes these as build
# artifacts instead — see the airbyte-*-contract lanes.
certification*.json
# Any evidence file, not just the e2e one. These are produced by a run against
# a specific deployment; committing one lets a stale artefact certify a release
# it never saw.
evidence-*.json
evidence-e2e*.json
mirror-lock.json
sources-k8s.json
destinations-k8s.json

# Editor/agent tooling metadata, not part of the product.
.serena/

# The vendored engine: several gigabytes of image tarballs. They travel with
# the project directory, not through git — `scripts/vendor-engine.py restore`
# loads them on a new machine, and `engine-lock.json` (which IS committed)
# records exactly which bytes they should be.
vendor/engine/*.tar

# Upstream data this repo downloads, not data it owns. `.cache/oss_registry.json`
# is 6.2 MB of Airbyte's connector registry; the *output* of processing it,
# `backend/app/resources/connector_registry.json`, is what gets committed.
.cache/

# Editor and assistant project state.
.serena/

# ── kept on the machine, not in the repository ─────────────────────────────
#
# The repository carries the product: the application, the deployment
# descriptors and the operational scripts. Tests, documentation and release
# evidence live beside it on the machines that run them.
#
# This is safe because nothing in `backend/` reads any of it. The Base field
# contracts used to be generated from YAML under `docs/`, which made a
# documentation folder a build input -- deleting it wrote an empty registry
# over the schemas of ten connectors. They are committed under
# `backend/app/connectors/base_vn/schemas/` now, and the image never contained
# `docs/` in the first place: the Dockerfile copies `backend/`.
#
# What this costs, stated rather than discovered later: a fresh clone has no
# test suite, so `pytest` has nothing to run and CI has nothing to check. Copy
# `qa/`, `pytest.ini` and `.github/` from a working machine to get them back.
qa/
docs/
evidence/
pytest.ini
.github/
